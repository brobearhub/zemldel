NODE_ENV=production
SWAGGER_ENABLED=0
FRONTEND_URL=https://zemledelpro.ru

# Use the EXISTING database hostname matching its certificate, not 192.168.x.x.
# Password must be URL-encoded. Upload the public CA with deploy-host.sh's fifth argument.
DATABASE_URL=postgresql://zemledel_app:REPLACE_URL_ENCODED_PASSWORD@REPLACE_EXISTING_DB_HOST:5432/zemledel_db_prod?sslmode=verify-full&sslrootcert=/run/db-certs/root.crt
INTERNAL_API_SECRET=REPLACE_WITH_SHARED_SECRET
SOCKET_JWT_SECRET=REPLACE_WITH_SHARED_SOCKET_SECRET
DOCUMENTS_MASTER_KEY_BASE64=REUSE_EXISTING_DOCUMENT_ENCRYPTION_KEY

# Copy backend_storage_environment from this Terraform configuration.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_KEY=REPLACE_FROM_TERRAFORM_OUTPUT
S3_SECRET=REPLACE_FROM_TERRAFORM_OUTPUT
S3_PUBLIC_BUCKET=REPLACE_FROM_TERRAFORM_OUTPUT
S3_PRIVATE_BUCKET=REPLACE_FROM_TERRAFORM_OUTPUT
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_PREFIX=public/
S3_PRIVATE_PREFIX=private/
CDN_PUBLIC_BASE_URL=https://cdn.zemledelpro.ru

MAIL_TRANSPORT=postbox
SMTP_FROM=support@zemledelpro.ru
POSTBOX_ACCESS_KEY_ID=REUSE_EXISTING_STATIC_ACCESS_KEY_ID
POSTBOX_SECRET_ACCESS_KEY=REUSE_EXISTING_STATIC_ACCESS_SECRET

# Telegram / MAX: токены только на backend. До настройки ботов worker выключен.
MESSENGER_SITE_URL="https://zemledelpro.ru"
MESSENGER_WORKER_ENABLED=false
TELEGRAM_BOT_USERNAME="zemledel_agent"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
MAX_BOT_USERNAME="id6679190271_bot"
MAX_BOT_TOKEN=""
MAX_WEBHOOK_SECRET=""

# Публичный адрес backend для регистрации webhook (без /messengers).
MESSENGER_WEBHOOK_BASE_URL=""

# Для LISTEN при transaction pooling: прямой адрес PostgreSQL (опционально).
# MESSENGER_LISTEN_DATABASE_URL="postgresql://..."
