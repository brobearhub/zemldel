NODE_ENV=production
NEXTAUTH_URL=https://zemledelpro.ru
NEXTAUTH_SECRET=REUSE_EXISTING_FRONTEND_SECRET
INTERNAL_API_SECRET=EXACTLY_THE_SAME_VALUE_AS_BACKEND
SOCKET_JWT_SECRET=EXACTLY_THE_SAME_VALUE_AS_BACKEND
