# Шаблон prod-env на ВМ (/opt/zemledel/.env, chmod 600).
# Значения заполняются из Lockbox вручную или через deploy.sh + yc lockbox.

# --- Container Registry (подставляет deploy.sh) ---
CR_REGISTRY=cr.yandex/crxxxxxxxx
IMAGE_TAG=latest

# --- Frontend (Next.js BFF + NextAuth) ---
NODE_ENV=production
NEXTAUTH_URL=https://zemledelpro.ru
NEXTAUTH_SECRET=
BACKEND_API_URL=http://backend:3003
INTERNAL_API_SECRET=
SOCKET_JWT_SECRET=

# --- Backend (NestJS) ---
PORT=3003
SWAGGER_ENABLED=0
FRONTEND_URL=https://zemledelpro.ru
DATABASE_URL=postgres://zemledel:PASSWORD@c-CLUSTER_ID.rw.mdb.yandexcloud.net:6432/zemledel?sslmode=verify-full&target_session_attrs=read-write
DOCUMENTS_MASTER_KEY_BASE64=

YA_S3_ENDPOINT=https://storage.yandexcloud.net
YA_S3_REGION=ru-central1
YA_S3_KEY=
YA_S3_SECRET=
YA_S3_PRIVATE_BUCKET=
YA_S3_PUBLIC_BUCKET=
YA_CDN_PUBLIC_BASE_URL=https://cdn.zemledelpro.ru
YA_S3_FORCE_PATH_STYLE=true

# --- Caddy ---
DOMAIN=zemledelpro.ru
CADDY_ADMIN_EMAIL=admin@zemledelpro.ru
