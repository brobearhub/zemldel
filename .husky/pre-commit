# До коммита: линт и production-сборка только тех пакетов, чьи файлы в индексе.
# Иначе ошибка типов всплывает уже в Docker-билде на деплое.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

staged=$(git diff --cached --name-only --diff-filter=ACMR)

if printf '%s\n' "$staged" | grep -q '^frontend/'; then
  echo "pre-commit: frontend lint"
  npm run lint --prefix frontend
  echo "pre-commit: frontend build"
  npm run build --prefix frontend
fi

if printf '%s\n' "$staged" | grep -q '^backend/'; then
  echo "pre-commit: backend lint"
  npm run lint:check --prefix backend
  echo "pre-commit: backend build"
  npm run build --prefix backend
fi
