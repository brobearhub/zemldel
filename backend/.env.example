PORT=3003
DATABASE_URL="postgres://postgres:postgres@localhost:5421/new_gorisons"
INTERNAL_API_SECRET="replace-with-strong-random-secret"
SOCKET_JWT_SECRET="replace-with-socket-jwt-secret"
FRONTEND_URL="http://localhost:3000"
DOCUMENTS_MASTER_KEY_BASE64="replace-with-32-bytes-base64"

# Yandex Object Storage (обязательно для старта backend)
YA_S3_ENDPOINT="https://storage.yandexcloud.net"
YA_S3_REGION="ru-central1"
YA_S3_KEY="replace-with-static-access-key-id"
YA_S3_SECRET="replace-with-static-secret-access-key"
YA_S3_PRIVATE_BUCKET="prod-zemledel-private"
YA_S3_PUBLIC_BUCKET="prod-zemledel-public"
YA_CDN_PUBLIC_BASE_URL="https://cdn.zemledelpro.ru"
YA_S3_FORCE_PATH_STYLE="true"
# YA_S3_PUBLIC_PREFIX="public/"
# YA_S3_PRIVATE_PREFIX="private/"

# Swagger / OpenAPI
# UI: http://localhost:${PORT}/api
# Spec JSON: http://localhost:${PORT}/api-json
SWAGGER_ENABLED=1
SWAGGER_TITLE="Zemledel PRO API"
SWAGGER_DESCRIPTION="API documentation for Zemledel PRO backend"
SWAGGER_VERSION="0.0.1"
