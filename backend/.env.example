PORT=3003
DATABASE_URL="postgres://postgres:postgres@localhost:5421/new_gorisons"
INTERNAL_API_SECRET="replace-with-strong-random-secret"
SOCKET_JWT_SECRET="replace-with-socket-jwt-secret"
FRONTEND_URL="http://localhost:4000"

# Только для окружения с искусственными документами: один публичный S3-бакет
# для фото, документов и паспортов без KMS. Реальные данные здесь недопустимы.
# NODE_ENV="testing"

# Почта для сброса пароля. Если SMTP_HOST пуст, ссылка пишется только в лог бэкенда.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="mailer@example.com"
# SMTP_PASSWORD="replace-with-smtp-password"
# SMTP_FROM="Земледел <mailer@example.com>"
# Локальный MailCatcher: см. docs/local-mail.md (SMTP 127.0.0.1:1026, UI :1081).
DOCUMENTS_MASTER_KEY_BASE64="replace-with-32-bytes-base64"

# Yandex Object Storage (обязательно для старта backend)
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_KEY="replace-with-static-access-key-id"
S3_SECRET="replace-with-static-secret-access-key"
S3_PRIVATE_BUCKET="prod-zemledel-private"
S3_PUBLIC_BUCKET="prod-zemledel-public"
CDN_PUBLIC_BASE_URL="https://cdn.zemledel.ru"
S3_FORCE_PATH_STYLE="true"
# S3_PUBLIC_PREFIX="public/"
# S3_PRIVATE_PREFIX="private/"

# Приватное хранилище документов и паспортов при NODE_ENV != testing.
# В testing используются S3_ENDPOINT/REGION/PUBLIC_BUCKET/KEY/SECRET выше.
# Историческое имя PASSPORT_S3_* сохранено для защищённых окружений.
PASSPORT_S3_ENDPOINT="https://storage.yandexcloud.net"
PASSPORT_S3_REGION="ru-central1"
PASSPORT_S3_BUCKET="replace-with-passport-bucket"
PASSPORT_S3_KMS_KEY_ID="replace-with-passport-kms-key-id"
PASSPORT_S3_ACCESS_KEY_ID="replace-with-passport-static-access-key-id"
PASSPORT_S3_SECRET_ACCESS_KEY="replace-with-passport-static-secret-access-key"

# Optional: a project-scoped Monium application key with Metrics write access only.
# Set both values to enable a 60-second health/cleanup metrics publisher.
PRIVATE_DOCUMENT_MONIUM_PROJECT=""
PRIVATE_DOCUMENT_MONIUM_APPLICATION_KEY=""
PRIVATE_DOCUMENT_MONIUM_SERVICE="private-documents-validation"

# Swagger / OpenAPI
# UI: http://localhost:${PORT}/api
# Spec JSON: http://localhost:${PORT}/api-json
SWAGGER_ENABLED=1
SWAGGER_TITLE="Zemledel PRO API"
SWAGGER_DESCRIPTION="API documentation for Zemledel PRO backend"
SWAGGER_VERSION="0.0.1"

# Telegram / MAX: токены только на backend. До настройки ботов worker выключен.
MESSENGER_SITE_URL="https://zemledel.ru"
MESSENGER_WORKER_ENABLED=false
TELEGRAM_BOT_USERNAME=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
MAX_BOT_USERNAME=""
MAX_BOT_TOKEN=""
MAX_WEBHOOK_SECRET=""

# Публичный адрес backend для регистрации webhook (без /messengers).
MESSENGER_WEBHOOK_BASE_URL=""

# Для LISTEN при transaction pooling: прямой адрес PostgreSQL (опционально).
# MESSENGER_LISTEN_DATABASE_URL="postgresql://..."

# T-Bank DEMO terminal only. Credentials belong exclusively to the backend.
TBANK_TEST_ENABLED=0
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_SITE_URL=https://zemledel.ru
TBANK_NOTIFICATION_URL=https://zemledel.ru/api/billing/tbank/notification

# Enable the persistent DEMO subscription renewal worker (once per minute).
TBANK_RENEWALS_ENABLED=0

# Tariff restrictions are paused until checkout is ready. Set to 1 to enforce them.
PLAN_ENFORCEMENT_ENABLED=0
