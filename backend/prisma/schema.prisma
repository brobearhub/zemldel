generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  PLATFORM_ADMIN
  CUSTOMER
}

enum ProviderType {
  SELF_EMPLOYED
  COMPANY
}

enum ProviderMemberRole {
  OWNER
  MANAGER
}

enum ProviderMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RequestStatus {
  NEW
  DISCUSSING
  TERMS_AGREED
  ACTIVE
  ACCEPTANCE_PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
  CLOSED
}

enum RequestProviderOfferStatus {
  SELECTED
  DECLINED
}

enum ServiceCategoryPlacement {
  HOME
}

enum ConversationStatus {
  OPEN
  ARCHIVED
}

enum AuthProviderKey {
  GOSUSLUGI
}

enum RequestContractFileStatus {
  PENDING_CUSTOMER
  APPROVED
  REVISION_REQUESTED
}

enum RequestContractFileRole {
  CONTRACT_DOCUMENT
  CONTRACT_SIGNATURE
  PROVIDER_MISC
}

enum RequestDocumentRequestStatus {
  REQUESTED
  UPLOADED
}

enum RequestRemarkStatus {
  OPEN
  DONE
}

enum RequestRemarkAuthorSide {
  CUSTOMER
  PROVIDER
}

enum WorkStageLifecycle {
  DRAFT
  PUBLISHED
}

enum WorkStageDocSlotStatus {
  REQUESTED
  UPLOADED
}

enum LegalDocId {
  TERMS
  PRIVACY
  CONSENT
  OFFER
}

enum LegalAcceptanceContext {
  SIGNUP
  PROVIDER_ONBOARDING
  CONTRACT
}

model City {
  id          String @id @default(uuid()) @db.Uuid
  garObjectId BigInt @unique
  objectGuid  String @unique @db.Uuid
  name        String
  typeName    String
  level       Int
  regionCode  String
  regionName  String

  customerUsers User[]     @relation("UserCustomerCity")
  providers     Provider[] @relation("ProviderCity")
  requests      Request[]  @relation("RequestCity")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionCode])
  @@index([regionCode, name])
}

model User {
  id                        String                   @id @default(uuid()) @db.Uuid
  email                     String                   @unique
  emailVerified             DateTime?
  name                      String?
  image                     String?
  systemRole                SystemRole               @default(CUSTOMER)
  passwordHash              String?
  phone                     String?
  activeProviderId          String?                  @db.Uuid
  customerCityId            String?                  @db.Uuid
  accounts                  Account[]
  sessions                  Session[]
  authProviderLinks         UserAuthProviderLink[]
  stepUpVerifications       UserStepUpVerification[]
  passportDocument          PassportDocument?
  passportAccessAudits      PassportAccessAudit[]    @relation("PassportAccessAuditPassportUser")
  uploadedRequestContractFiles RequestContractFile[] @relation("RequestContractFileUploadedBy")
  decidedRequestContractFiles  RequestContractFile[] @relation("RequestContractFileDecidedBy")
  uploadedRequestDocumentRequests RequestDocumentRequest[] @relation("RequestDocumentRequestUploadedBy")
  providerMemberships       ProviderMember[]
  providerUserSettings      ProviderUserSettings[]
  customerLegalProfile      CustomerLegalProfile?
  ownedProviders            Provider[]               @relation("ProviderOwner")
  createdServices           Service[]                @relation("ServiceCreatedBy")
  updatedServices           Service[]                @relation("ServiceUpdatedBy")
  requests                  Request[]
  legalAcceptances          LegalAcceptance[]
  sentChatMessages          Message[]                @relation("MessageSender")
  chatReadStates            ConversationReadState[]
  customerConversations     Conversation[]           @relation("ConversationCustomer")
  createdRequestRemarks     RequestRemark[]          @relation("RequestRemarkCreatedByUser")
  doneRequestRemarks        RequestRemark[]          @relation("RequestRemarkDoneByUser")
  createdRequestPayments    RequestPayment[]         @relation("RequestPaymentCreatedByUser")
  activeProvider            Provider?                @relation("ActiveProvider", fields: [activeProviderId], references: [id], onDelete: SetNull)
  customerCity              City?                    @relation("UserCustomerCity", fields: [customerCityId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([systemRole])
  @@index([activeProviderId])
  @@index([customerCityId])
}

model LegalAcceptance {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @db.Uuid
  docId      LegalDocId
  version    String
  context    LegalAcceptanceContext
  requestId  String?                 @db.Uuid
  acceptedAt DateTime                @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  request Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([userId, docId])
  @@index([requestId])
  @@index([context, docId])
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Provider {
  id                String                 @id @default(uuid()) @db.Uuid
  name              String
  slug              String                 @unique
  type              ProviderType
  ownerUserId       String?                @db.Uuid
  cityId            String?                @db.Uuid
  ownerUser         User?                  @relation("ProviderOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  members           ProviderMember[]
  userSettings      ProviderUserSettings[]
  legalProfile      ProviderLegalProfile?
  requestContractFiles RequestContractFile[]
  requestDocumentRequests RequestDocumentRequest[]
  workStages        RequestWorkStage[]
  services          Service[]
  conversations     Conversation[]
  requests          Request[]
  requestOffers     RequestProviderOffer[]
  reminders         RequestReminder[]
  requestPayments   RequestPayment[]
  createdRequestRemarks RequestRemark[] @relation("RequestRemarkCreatedByProvider")
  doneRequestRemarks    RequestRemark[] @relation("RequestRemarkDoneByProvider")
  activeUsers       User[]                 @relation("ActiveProvider")
  city              City?                  @relation("ProviderCity", fields: [cityId], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([ownerUserId])
  @@index([type])
  @@index([cityId])
}

model ProviderLegalProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  providerId           String   @unique @db.Uuid
  legalName            String?
  inn                  String?
  kpp                  String?
  ogrn                 String?
  legalAddress         String?
  postalAddress        String?
  bankName             String?
  bankBik              String?
  bankAccount          String?
  correspondentAccount String?
  signerName           String?
  signerTitle          String?
  signerBasis          String?
  phone                String?
  email                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model CustomerLegalProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  fullName            String?
  inn                 String?
  registrationAddress String?
  postalAddress       String?
  phone               String?
  email               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProviderMember {
  id         String               @id @default(uuid()) @db.Uuid
  providerId String               @db.Uuid
  userId     String               @db.Uuid
  role       ProviderMemberRole
  status     ProviderMemberStatus @default(ACTIVE)
  provider   Provider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([providerId, userId])
  @@index([userId])
  @@index([providerId, role, status])
}

model ProviderUserSettings {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  providerId        String   @db.Uuid
  proInboxFilters   Json?
  workStageStatuses Json?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, providerId])
  @@index([userId])
  @@index([providerId])
}

model ServiceCategory {
  id         String                     @id @default(uuid()) @db.Uuid
  name       String
  slug       String                     @unique
  parentId   String?                    @db.Uuid
  sortOrder  Int?
  placements ServiceCategoryPlacement[] @default([])

  parent   ServiceCategory?  @relation("ServiceCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children ServiceCategory[] @relation("ServiceCategoryParent")

  services Service[]
  requests Request[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([slug])
}

model Request {
  id     String        @id @default(uuid()) @db.Uuid
  status RequestStatus @default(NEW)

  serviceId      String? @db.Uuid
  categoryId     String? @db.Uuid
  providerId     String? @db.Uuid
  customerUserId String? @db.Uuid
  requestCityId  String? @db.Uuid

  customerName  String?
  customerEmail String?
  customerPhone String?
  message           String?
  location          String?
  cadastralNumbers  String[]  @default([])
  lockedAt          DateTime?

  dealTerms                Json?
  offerVersion             String?
  termsVersion             String?
  contractAcceptedAt       DateTime?
  contractAcceptedByUserId String?   @db.Uuid
  acceptanceRequestedAt    DateTime?
  autoAcceptAt             DateTime?
  acceptedAt               DateTime?
  acceptedByUserId         String?   @db.Uuid
  totalAmountRubles        Int?

  service           Service?               @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  category          ServiceCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  provider          Provider?              @relation(fields: [providerId], references: [id], onDelete: SetNull)
  customerUser      User?                  @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  requestCity       City?                  @relation("RequestCity", fields: [requestCityId], references: [id], onDelete: SetNull)
  conversations     Conversation[]
  providerOffers    RequestProviderOffer[]
  legalAcceptances  LegalAcceptance[]
  events            RequestEvent[]
  contractFiles     RequestContractFile[]
  documentRequests  RequestDocumentRequest[]
  workStages        RequestWorkStage[]
  reminders         RequestReminder[]
  remarks           RequestRemark[]
  payments          RequestPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerUserId, status])
  @@index([providerId, status])
  @@index([categoryId, status])
  @@index([serviceId, status])
  @@index([requestCityId, status])
}

model RequestWorkStage {
  id          String             @id @default(uuid()) @db.Uuid
  requestId   String             @db.Uuid
  providerId  String             @db.Uuid
  title       String
  description String             @default("")
  statusKey   String
  statusLabel String
  lifecycle   WorkStageLifecycle @default(DRAFT)
  publishedAt DateTime?
  sortOrder   Int                @default(0)

  request  Request                   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider Provider                  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  files    RequestWorkStageFile[]
  docSlots RequestWorkStageDocSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, sortOrder])
  @@index([providerId, statusKey])
  @@index([requestId, lifecycle])
}

model RequestWorkStageFile {
  id               String  @id @default(uuid()) @db.Uuid
  stageId          String  @db.Uuid
  uploadedByUserId String? @db.Uuid
  originalName     String
  mimeType         String
  sizeBytes        Int
  sha256           String
  storageRelPath   String

  stage RequestWorkStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId, createdAt])
}

model RequestWorkStageDocSlot {
  id               String                 @id @default(uuid()) @db.Uuid
  stageId          String                 @db.Uuid
  title            String
  status           WorkStageDocSlotStatus @default(REQUESTED)
  uploadedByUserId String?                @db.Uuid
  uploadedAt       DateTime?
  originalName     String?
  mimeType         String?
  sizeBytes        Int?
  sha256           String?
  storageRelPath   String?

  stage RequestWorkStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId, createdAt])
  @@index([stageId, status])
}

model RequestRemark {
  id         String                @id @default(uuid()) @db.Uuid
  requestId  String                @db.Uuid
  authorSide RequestRemarkAuthorSide
  status     RequestRemarkStatus   @default(OPEN)
  text       String

  createdByUserId     String?  @db.Uuid
  createdByProviderId String?  @db.Uuid
  doneByUserId        String?  @db.Uuid
  doneByProviderId    String?  @db.Uuid
  doneAt              DateTime?
  sentAt              DateTime?

  request           Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdByUser     User?     @relation("RequestRemarkCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  doneByUser        User?     @relation("RequestRemarkDoneByUser", fields: [doneByUserId], references: [id], onDelete: SetNull)
  createdByProvider Provider? @relation("RequestRemarkCreatedByProvider", fields: [createdByProviderId], references: [id], onDelete: SetNull)
  doneByProvider    Provider? @relation("RequestRemarkDoneByProvider", fields: [doneByProviderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, createdAt])
  @@index([requestId, status])
  @@index([authorSide, status])
}

model RequestPayment {
  id              String   @id @default(uuid()) @db.Uuid
  requestId       String   @db.Uuid
  providerId      String   @db.Uuid
  type            RequestPaymentType @default(CONTRACT)
  amountRubles    Int
  comment         String
  paidAt          DateTime?
  createdByUserId String?  @db.Uuid

  request       Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider      Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation("RequestPaymentCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, paidAt])
  @@index([providerId, paidAt])
}

enum RequestPaymentType {
  CONTRACT
  OTHER
}

model RequestEvent {
  id              String   @id @default(uuid()) @db.Uuid
  requestId       String   @db.Uuid
  type            String
  actorUserId     String?  @db.Uuid
  actorProviderId String?  @db.Uuid
  payload         Json?
  createdAt       DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([type, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actorProviderId, createdAt])
}

model RequestProviderOffer {
  id         String                     @id @default(uuid()) @db.Uuid
  requestId  String                     @db.Uuid
  providerId String                     @db.Uuid
  status     RequestProviderOfferStatus @default(SELECTED)
  selectedAt DateTime                   @default(now())
  declinedAt DateTime?

  request  Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, providerId])
  @@index([requestId, status])
  @@index([providerId, status])
}

model Service {
  id              String          @id @default(uuid()) @db.Uuid
  categoryId      String          @db.Uuid
  status          ServiceStatus   @default(DRAFT)
  title           String
  image           String?
  stockBadge      String?
  price           String
  rating          Float?
  reviewCount     Int?
  ctaText         String
  ctaHref         String?
  description     String?
  highlight       String?
  badge           String?
  paletteColor    String?
  icon            String?
  providerId      String          @db.Uuid
  createdByUserId String?         @db.Uuid
  updatedByUserId String?         @db.Uuid
  publishedAt     DateTime?
  provider        Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdByUser   User?           @relation("ServiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?           @relation("ServiceUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  requests        Request[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([categoryId])
  @@index([providerId])
  @@index([status])
  @@index([providerId, status])
}

model Conversation {
  id             String                  @id @default(uuid()) @db.Uuid
  requestId      String                  @db.Uuid
  providerId     String                  @db.Uuid
  customerUserId String                  @db.Uuid
  status         ConversationStatus      @default(OPEN)
  lastMessageAt  DateTime?
  request        Request                 @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider       Provider                @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerUser   User                    @relation("ConversationCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  messages       Message[]
  readStates     ConversationReadState[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([requestId, providerId])
  @@index([providerId])
  @@index([customerUserId])
  @@index([requestId])
}

model Message {
  id               String       @id @default(uuid()) @db.Uuid
  conversationId   String       @db.Uuid
  senderUserId     String       @db.Uuid
  clientMessageId  String       @db.Uuid
  body             String
  replyToMessageId String?      @db.Uuid
  createdAt        DateTime     @default(now())
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  replyTo          Message?     @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]    @relation("MessageReplies")

  @@unique([conversationId, senderUserId, clientMessageId])
  @@index([conversationId, createdAt])
}

model ConversationReadState {
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model UserAuthProviderLink {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  providerKey     AuthProviderKey
  externalSubject String
  linkedAt        DateTime        @default(now())
  revokedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerKey])
  @@unique([providerKey, externalSubject])
  @@index([userId, providerKey])
}

model UserStepUpVerification {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  providerKey AuthProviderKey
  verifiedAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerKey])
  @@index([userId, providerKey, verifiedAt])
}

model PassportDocument {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  alg        String
  keyVersion Int
  iv         Bytes    @db.ByteA
  tag        Bytes    @db.ByteA
  ciphertext Bytes    @db.ByteA
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PassportAccessAudit {
  id              String   @id @default(uuid()) @db.Uuid
  passportUserId  String   @db.Uuid
  action          String
  actorUserId     String?  @db.Uuid
  actorProviderId String?  @db.Uuid
  requestId       String?  @db.Uuid
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())

  passportUser User @relation("PassportAccessAuditPassportUser", fields: [passportUserId], references: [id], onDelete: Cascade)

  @@index([passportUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actorProviderId, createdAt])
  @@index([requestId, createdAt])
}

model RequestContractFile {
  id             String                   @id @default(uuid()) @db.Uuid
  requestId      String                   @db.Uuid
  providerId     String                   @db.Uuid
  uploadedByUserId String?                @db.Uuid
  decidedByUserId  String?                @db.Uuid
  decidedAt      DateTime?
  status         RequestContractFileStatus @default(PENDING_CUSTOMER)
  revisionMessage String?
  role           RequestContractFileRole  @default(CONTRACT_DOCUMENT)
  bundleId       String?                  @db.Uuid

  originalName   String
  mimeType       String
  sizeBytes      Int
  sha256         String
  storageRelPath String

  request        Request                  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider       Provider                 @relation(fields: [providerId], references: [id], onDelete: Cascade)
  uploadedByUser User?                    @relation("RequestContractFileUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  decidedByUser  User?                    @relation("RequestContractFileDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, updatedAt])
  @@index([providerId, updatedAt])
  @@index([status, updatedAt])
  @@index([bundleId, updatedAt])
}

model RequestDocumentRequest {
  id              String                     @id @default(uuid()) @db.Uuid
  requestId       String                     @db.Uuid
  providerId      String                     @db.Uuid
  uploadedByUserId String?                   @db.Uuid
  uploadedAt      DateTime?
  status          RequestDocumentRequestStatus @default(REQUESTED)

  title           String

  originalName    String?
  mimeType        String?
  sizeBytes       Int?
  sha256          String?
  storageRelPath  String?

  request         Request                    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider        Provider                   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  uploadedByUser  User?                      @relation("RequestDocumentRequestUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, createdAt])
  @@index([requestId, status])
  @@index([providerId, updatedAt])
  @@index([status, updatedAt])
}

model RequestReminder {
  id         String    @id @default(uuid()) @db.Uuid
  requestId  String    @db.Uuid
  providerId String    @db.Uuid
  text       String
  remindAt   DateTime
  isDone     Boolean   @default(false)
  doneAt     DateTime?

  request  Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, remindAt])
  @@index([providerId, remindAt])
  @@index([providerId, isDone, remindAt])
}
