generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  PLATFORM_ADMIN
  CUSTOMER
}

enum ProviderType {
  SELF_EMPLOYED
  COMPANY
}

enum ProviderMemberRole {
  OWNER
  MANAGER
}

enum ProviderMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RequestStatus {
  NEW
  DISCUSSING
  TERMS_AGREED
  PROVIDER_SELECTED
  CONTRACT_ACCEPTED
  LOCKED
  PAYMENT_PENDING
  PAYMENT_PROCESSING
  ACTIVE
  SERVICE_RENDERED
  ACCEPTANCE_PENDING
  ACCEPTED
  PAID
  COMPLETED
  CANCELLED
  CLOSED
}

enum RequestProviderOfferStatus {
  SELECTED
  DECLINED
}

enum ServiceCategoryPlacement {
  HOME
}

enum ConversationStatus {
  OPEN
  ARCHIVED
}

enum PaymentType {
  PAYMENT
  PAYOUT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AuthProviderKey {
  GOSUSLUGI
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

enum ContractSignerRole {
  CUSTOMER
  PROVIDER
}

enum ContractBlockStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContractCommentStatus {
  OPEN
  RESOLVED
}

model City {
  id          String @id @default(uuid()) @db.Uuid
  garObjectId BigInt @unique
  objectGuid  String @unique @db.Uuid
  name        String
  typeName    String
  level       Int
  regionCode  String
  regionName  String

  customerUsers User[]     @relation("UserCustomerCity")
  providers     Provider[] @relation("ProviderCity")
  requests      Request[]  @relation("RequestCity")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionCode])
  @@index([regionCode, name])
}

model User {
  id                        String                   @id @default(uuid()) @db.Uuid
  email                     String                   @unique
  emailVerified             DateTime?
  name                      String?
  image                     String?
  systemRole                SystemRole               @default(CUSTOMER)
  passwordHash              String?
  phone                     String?
  activeProviderId          String?                  @db.Uuid
  customerCityId            String?                  @db.Uuid
  accounts                  Account[]
  sessions                  Session[]
  authProviderLinks         UserAuthProviderLink[]
  stepUpVerifications       UserStepUpVerification[]
  passportDocument          PassportDocument?
  passportAccessAudits      PassportAccessAudit[]    @relation("PassportAccessAuditPassportUser")
  customerContractInstances ContractInstance[]       @relation("ContractInstanceCustomer")
  contractSignatures        ContractSignature[]      @relation("ContractSignatureSigner")
  contractFeedbacks         ContractFeedback[]       @relation("ContractFeedbackAuthor")
  contractCommentThreads    ContractCommentThread[]  @relation("ContractCommentThreadAuthor")
  contractComments          ContractComment[]        @relation("ContractCommentAuthor")
  resolvedContractComments  ContractCommentThread[]  @relation("ContractCommentThreadResolvedBy")
  providerMemberships       ProviderMember[]
  providerUserSettings      ProviderUserSettings[]
  customerLegalProfile      CustomerLegalProfile?
  ownedProviders            Provider[]               @relation("ProviderOwner")
  createdServices           Service[]                @relation("ServiceCreatedBy")
  updatedServices           Service[]                @relation("ServiceUpdatedBy")
  requests                  Request[]
  sentChatMessages          Message[]                @relation("MessageSender")
  chatReadStates            ConversationReadState[]
  customerConversations     Conversation[]           @relation("ConversationCustomer")
  activeProvider            Provider?                @relation("ActiveProvider", fields: [activeProviderId], references: [id], onDelete: SetNull)
  customerCity              City?                    @relation("UserCustomerCity", fields: [customerCityId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([systemRole])
  @@index([activeProviderId])
  @@index([customerCityId])
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Provider {
  id                String                 @id @default(uuid()) @db.Uuid
  name              String
  slug              String                 @unique
  type              ProviderType
  ownerUserId       String?                @db.Uuid
  cityId            String?                @db.Uuid
  ownerUser         User?                  @relation("ProviderOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  members           ProviderMember[]
  userSettings      ProviderUserSettings[]
  legalProfile      ProviderLegalProfile?
  contractTemplates ContractTemplate[]
  contractInstances ContractInstance[]
  services          Service[]
  conversations     Conversation[]
  requests          Request[]
  requestOffers     RequestProviderOffer[]
  reminders         RequestReminder[]
  activeUsers       User[]                 @relation("ActiveProvider")
  city              City?                  @relation("ProviderCity", fields: [cityId], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([ownerUserId])
  @@index([type])
  @@index([cityId])
}

model ProviderLegalProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  providerId           String   @unique @db.Uuid
  legalName            String?
  inn                  String?
  kpp                  String?
  ogrn                 String?
  legalAddress         String?
  postalAddress        String?
  bankName             String?
  bankBik              String?
  bankAccount          String?
  correspondentAccount String?
  signerName           String?
  signerTitle          String?
  signerBasis          String?
  phone                String?
  email                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model CustomerLegalProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  fullName            String?
  inn                 String?
  registrationAddress String?
  postalAddress       String?
  phone               String?
  email               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProviderMember {
  id         String               @id @default(uuid()) @db.Uuid
  providerId String               @db.Uuid
  userId     String               @db.Uuid
  role       ProviderMemberRole
  status     ProviderMemberStatus @default(ACTIVE)
  provider   Provider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([providerId, userId])
  @@index([userId])
  @@index([providerId, role, status])
}

model ProviderUserSettings {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  providerId      String   @db.Uuid
  proInboxFilters Json?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, providerId])
  @@index([userId])
  @@index([providerId])
}

model ServiceCategory {
  id         String                     @id @default(uuid()) @db.Uuid
  name       String
  slug       String                     @unique
  parentId   String?                    @db.Uuid
  sortOrder  Int?
  placements ServiceCategoryPlacement[] @default([])

  parent   ServiceCategory?  @relation("ServiceCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children ServiceCategory[] @relation("ServiceCategoryParent")

  services Service[]
  requests Request[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([slug])
}

model Request {
  id     String        @id @default(uuid()) @db.Uuid
  status RequestStatus @default(NEW)

  serviceId      String? @db.Uuid
  categoryId     String? @db.Uuid
  providerId     String? @db.Uuid
  customerUserId String? @db.Uuid
  requestCityId  String? @db.Uuid

  customerName  String?
  customerEmail String?
  customerPhone String?
  message       String?
  location      String?
  lockedAt      DateTime?

  dealTerms                Json?
  offerVersion             String?
  contractAcceptedAt       DateTime?
  contractAcceptedByUserId String?   @db.Uuid
  acceptanceRequestedAt    DateTime?
  autoAcceptAt             DateTime?
  acceptedAt               DateTime?
  acceptedByUserId         String?   @db.Uuid

  service           Service?               @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  category          ServiceCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  provider          Provider?              @relation(fields: [providerId], references: [id], onDelete: SetNull)
  customerUser      User?                  @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  requestCity       City?                  @relation("RequestCity", fields: [requestCityId], references: [id], onDelete: SetNull)
  conversations     Conversation[]
  providerOffers    RequestProviderOffer[]
  events            RequestEvent[]
  payments          Payment[]
  contractInstances ContractInstance[]
  reminders         RequestReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerUserId, status])
  @@index([providerId, status])
  @@index([categoryId, status])
  @@index([serviceId, status])
  @@index([requestCityId, status])
}

model RequestEvent {
  id              String   @id @default(uuid()) @db.Uuid
  requestId       String   @db.Uuid
  type            String
  actorUserId     String?  @db.Uuid
  actorProviderId String?  @db.Uuid
  payload         Json?
  createdAt       DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([type, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actorProviderId, createdAt])
}

model RequestProviderOffer {
  id         String                     @id @default(uuid()) @db.Uuid
  requestId  String                     @db.Uuid
  providerId String                     @db.Uuid
  status     RequestProviderOfferStatus @default(SELECTED)
  selectedAt DateTime                   @default(now())
  declinedAt DateTime?

  request  Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, providerId])
  @@index([requestId, status])
  @@index([providerId, status])
}

model Service {
  id              String          @id @default(uuid()) @db.Uuid
  categoryId      String          @db.Uuid
  status          ServiceStatus   @default(DRAFT)
  title           String
  image           String?
  stockBadge      String?
  price           String
  rating          Float?
  reviewCount     Int?
  ctaText         String
  ctaHref         String?
  description     String?
  highlight       String?
  badge           String?
  paletteColor    String?
  icon            String?
  providerId      String          @db.Uuid
  createdByUserId String?         @db.Uuid
  updatedByUserId String?         @db.Uuid
  publishedAt     DateTime?
  provider        Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdByUser   User?           @relation("ServiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?           @relation("ServiceUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  requests        Request[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([categoryId])
  @@index([providerId])
  @@index([status])
  @@index([providerId, status])
}

model Conversation {
  id             String                  @id @default(uuid()) @db.Uuid
  requestId      String                  @db.Uuid
  providerId     String                  @db.Uuid
  customerUserId String                  @db.Uuid
  status         ConversationStatus      @default(OPEN)
  lastMessageAt  DateTime?
  request        Request                 @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider       Provider                @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerUser   User                    @relation("ConversationCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  messages       Message[]
  readStates     ConversationReadState[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([requestId, providerId])
  @@index([providerId])
  @@index([customerUserId])
  @@index([requestId])
}

model Message {
  id               String       @id @default(uuid()) @db.Uuid
  conversationId   String       @db.Uuid
  senderUserId     String       @db.Uuid
  clientMessageId  String       @db.Uuid
  body             String
  replyToMessageId String?      @db.Uuid
  createdAt        DateTime     @default(now())
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  replyTo          Message?     @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]    @relation("MessageReplies")

  @@unique([conversationId, senderUserId, clientMessageId])
  @@index([conversationId, createdAt])
}

model ConversationReadState {
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  requestId             String        @db.Uuid
  type                  PaymentType
  status                PaymentStatus @default(PENDING)
  providerKey           String
  amountMinor           Int
  currency              String        @default("RUB")
  externalId            String?
  payload               Json?
  initiatedByUserId     String?       @db.Uuid
  initiatedByProviderId String?       @db.Uuid
  confirmedAt           DateTime?
  failedAt              DateTime?
  request               Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([requestId, type, status])
  @@index([providerKey, externalId])
}

model UserAuthProviderLink {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  providerKey     AuthProviderKey
  externalSubject String
  linkedAt        DateTime        @default(now())
  revokedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerKey])
  @@unique([providerKey, externalSubject])
  @@index([userId, providerKey])
}

model UserStepUpVerification {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  providerKey AuthProviderKey
  verifiedAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerKey])
  @@index([userId, providerKey, verifiedAt])
}

model PassportDocument {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  alg        String
  keyVersion Int
  iv         Bytes    @db.ByteA
  tag        Bytes    @db.ByteA
  ciphertext Bytes    @db.ByteA
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PassportAccessAudit {
  id              String   @id @default(uuid()) @db.Uuid
  passportUserId  String   @db.Uuid
  action          String
  actorUserId     String?  @db.Uuid
  actorProviderId String?  @db.Uuid
  requestId       String?  @db.Uuid
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())

  passportUser User @relation("PassportAccessAuditPassportUser", fields: [passportUserId], references: [id], onDelete: Cascade)

  @@index([passportUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actorProviderId, createdAt])
  @@index([requestId, createdAt])
}

model ContractTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  providerId       String   @db.Uuid
  title            String
  content          Json
  editorFormat     String   @default("markdown")
  editorVersion    Int      @default(1)
  variables        Json?
  version          Int      @default(1)
  parentTemplateId String?  @db.Uuid
  createdByUserId  String?  @db.Uuid
  updatedByUserId  String?  @db.Uuid
  lastRevisionAt   DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  provider          Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  parentTemplate    ContractTemplate?  @relation("ContractTemplateParent", fields: [parentTemplateId], references: [id], onDelete: SetNull)
  childrenTemplates ContractTemplate[] @relation("ContractTemplateParent")
  instances         ContractInstance[]

  @@index([providerId, updatedAt])
  @@index([parentTemplateId])
}

model ContractInstance {
  id               String         @id @default(uuid()) @db.Uuid
  providerId       String         @db.Uuid
  requestId        String?        @db.Uuid
  customerUserId   String?        @db.Uuid
  templateId       String?        @db.Uuid
  title            String
  content          Json
  editorFormat     String         @default("markdown")
  editorVersion    Int            @default(1)
  variableSnapshot Json?
  revision         Int            @default(1)
  status           ContractStatus @default(DRAFT)
  pdfHash          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  provider       Provider                @relation(fields: [providerId], references: [id], onDelete: Cascade)
  request        Request?                @relation(fields: [requestId], references: [id], onDelete: SetNull)
  customerUser   User?                   @relation("ContractInstanceCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)
  template       ContractTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  signatures     ContractSignature[]
  feedback       ContractFeedback[]
  commentThreads ContractCommentThread[]

  @@index([providerId, updatedAt])
  @@index([requestId])
  @@index([customerUserId, updatedAt])
  @@index([status, updatedAt])
}

model ContractBlock {
  id              String              @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  category        String?
  status          ContractBlockStatus @default(DRAFT)
  content         Json
  version         Int                 @default(1)
  createdByUserId String?             @db.Uuid
  updatedByUserId String?             @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  versions ContractBlockVersion[]

  @@index([status, updatedAt])
  @@index([category])
}

model ContractBlockVersion {
  id              String   @id @default(uuid()) @db.Uuid
  blockId         String   @db.Uuid
  version         Int
  title           String
  description     String?
  category        String?
  content         Json
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())

  block ContractBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, version])
  @@index([blockId, createdAt])
}

model ContractFeedback {
  id           String             @id @default(uuid()) @db.Uuid
  contractId   String             @db.Uuid
  authorRole   ContractSignerRole
  authorUserId String?            @db.Uuid
  body         String
  createdAt    DateTime           @default(now())

  contract   ContractInstance @relation(fields: [contractId], references: [id], onDelete: Cascade)
  authorUser User?            @relation("ContractFeedbackAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
  @@index([authorUserId, createdAt])
}

model ContractCommentThread {
  id               String                @id @default(uuid()) @db.Uuid
  contractId       String                @db.Uuid
  anchor           Json
  quote            String?
  status           ContractCommentStatus @default(OPEN)
  createdByRole    ContractSignerRole
  createdByUserId  String?               @db.Uuid
  resolvedByUserId String?               @db.Uuid
  resolvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  contract       ContractInstance  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdByUser  User?             @relation("ContractCommentThreadAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resolvedByUser User?             @relation("ContractCommentThreadResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  comments       ContractComment[]

  @@index([contractId, status, createdAt])
  @@index([createdByUserId, createdAt])
}

model ContractComment {
  id           String             @id @default(uuid()) @db.Uuid
  threadId     String             @db.Uuid
  authorRole   ContractSignerRole
  authorUserId String?            @db.Uuid
  body         String
  createdAt    DateTime           @default(now())

  thread     ContractCommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUser User?                 @relation("ContractCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([authorUserId, createdAt])
}

model ContractSignature {
  id           String             @id @default(uuid()) @db.Uuid
  contractId   String             @db.Uuid
  signerRole   ContractSignerRole
  signerUserId String?            @db.Uuid
  method       String
  docHash      String
  ip           String?
  userAgent    String?
  signedAt     DateTime           @default(now())

  contract   ContractInstance @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signerUser User?            @relation("ContractSignatureSigner", fields: [signerUserId], references: [id], onDelete: SetNull)

  @@unique([contractId, signerRole])
  @@index([contractId, signedAt])
  @@index([signerUserId, signedAt])
}

model RequestReminder {
  id         String    @id @default(uuid()) @db.Uuid
  requestId  String    @db.Uuid
  providerId String    @db.Uuid
  text       String
  remindAt   DateTime
  isDone     Boolean   @default(false)
  doneAt     DateTime?

  request  Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, remindAt])
  @@index([providerId, remindAt])
  @@index([providerId, isDone, remindAt])
}
