generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  PLATFORM_ADMIN
  CUSTOMER
}

enum ProviderType {
  SELF_EMPLOYED
  COMPANY
}

enum ProviderMemberRole {
  OWNER
  MANAGER
}

enum ProviderMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ServiceRequestStatus {
  NEW
  DISCUSSING
  LOCKED
  ACTIVE
  COMPLETED
  CANCELLED
  CLOSED
}

enum ServiceRequestPendingInitiator {
  CUSTOMER
  PROVIDER
}

enum ServiceCategoryPlacement {
  HOME
}

enum ConversationStatus {
  OPEN
  ARCHIVED
}

model City {
  id          String   @id @default(uuid()) @db.Uuid
  garObjectId BigInt   @unique
  objectGuid  String   @unique @db.Uuid
  name        String
  typeName    String
  level       Int
  regionCode  String
  regionName  String

  customerUsers User[]    @relation("UserCustomerCity")
  providers     Provider[] @relation("ProviderCity")
  serviceRequests ServiceRequest[] @relation("ServiceRequestCity")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([regionCode])
  @@index([regionCode, name])
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  systemRole       SystemRole       @default(CUSTOMER)
  passwordHash     String?
  phone            String?
  activeProviderId String?          @db.Uuid
  customerCityId   String?          @db.Uuid
  accounts         Account[]
  sessions         Session[]
  providerMemberships ProviderMember[]
  providerUserSettings ProviderUserSettings[]
  ownedProviders   Provider[]       @relation("ProviderOwner")
  createdServices  Service[]        @relation("ServiceCreatedBy")
  updatedServices  Service[]        @relation("ServiceUpdatedBy")
  serviceRequests  ServiceRequest[]
  sentChatMessages Message[]        @relation("MessageSender")
  chatReadStates   ConversationReadState[]
  customerConversations Conversation[] @relation("ConversationCustomer")
  activeProvider   Provider?        @relation("ActiveProvider", fields: [activeProviderId], references: [id], onDelete: SetNull)
  customerCity     City?            @relation("UserCustomerCity", fields: [customerCityId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([systemRole])
  @@index([activeProviderId])
  @@index([customerCityId])
}

model Account {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Provider {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  slug        String         @unique
  type        ProviderType
  ownerUserId String?        @db.Uuid
  cityId      String?        @db.Uuid
  ownerUser   User?          @relation("ProviderOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  members     ProviderMember[]
  userSettings ProviderUserSettings[]
  services    Service[]
  conversations Conversation[]
  serviceRequests ServiceRequest[]
  pendingServiceRequests ServiceRequest[] @relation("ServiceRequestPendingProvider")
  activeUsers User[]         @relation("ActiveProvider")
  city        City?          @relation("ProviderCity", fields: [cityId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([ownerUserId])
  @@index([type])
  @@index([cityId])
}

model ProviderMember {
  id         String               @id @default(uuid()) @db.Uuid
  providerId String               @db.Uuid
  userId     String               @db.Uuid
  role       ProviderMemberRole
  status     ProviderMemberStatus @default(ACTIVE)
  provider   Provider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([providerId, userId])
  @@index([userId])
  @@index([providerId, role, status])
}

model ProviderUserSettings {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  providerId     String   @db.Uuid
  proInboxFilters Json?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, providerId])
  @@index([userId])
  @@index([providerId])
}

model ServiceCategory {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  slug      String            @unique
  parentId  String?           @db.Uuid
  sortOrder Int?
  placements ServiceCategoryPlacement[] @default([])

  parent    ServiceCategory?  @relation("ServiceCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  ServiceCategory[] @relation("ServiceCategoryParent")

  services  Service[]
  serviceRequests ServiceRequest[]

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([parentId])
  @@index([slug])
}

model ServiceRequest {
  id             String              @id @default(uuid()) @db.Uuid
  status         ServiceRequestStatus @default(NEW)

  serviceId      String?             @db.Uuid
  categoryId     String?             @db.Uuid
  providerId     String?             @db.Uuid
  pendingProviderId String?          @db.Uuid
  pendingInitiator  ServiceRequestPendingInitiator?
  pendingAt         DateTime?
  customerUserId String?             @db.Uuid
  requestCityId  String?             @db.Uuid

  customerName   String?
  customerEmail  String?
  customerPhone  String?
  message        String?
  location       String?

  lockedAt       DateTime?

  service        Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  category       ServiceCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  provider       Provider?            @relation(fields: [providerId], references: [id], onDelete: SetNull)
  pendingProvider Provider?          @relation("ServiceRequestPendingProvider", fields: [pendingProviderId], references: [id], onDelete: SetNull)
  customerUser   User?               @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  requestCity    City?               @relation("ServiceRequestCity", fields: [requestCityId], references: [id], onDelete: SetNull)
  conversations  Conversation[]

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([customerUserId, status])
  @@index([providerId, status])
  @@index([categoryId, status])
  @@index([serviceId, status])
  @@index([pendingProviderId, status])
  @@index([requestCityId, status])
}

model Service {
  id              String    @id @default(uuid()) @db.Uuid
  categoryId      String    @db.Uuid
  status          ServiceStatus @default(DRAFT)
  title           String
  image           String?
  stockBadge      String?
  price           String
  rating          Float?
  reviewCount     Int?
  ctaText         String
  ctaHref         String?
  description     String?
  highlight       String?
  badge           String?
  paletteColor    String?
  icon            String?
  providerId      String    @db.Uuid
  createdByUserId String?   @db.Uuid
  updatedByUserId String?   @db.Uuid
  publishedAt     DateTime?
  provider        Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdByUser   User?     @relation("ServiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?     @relation("ServiceUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  serviceRequests ServiceRequest[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([categoryId])
  @@index([providerId])
  @@index([status])
  @@index([providerId, status])
}

model Conversation {
  id             String             @id @default(uuid()) @db.Uuid
  serviceRequestId String           @db.Uuid
  providerId     String             @db.Uuid
  customerUserId String             @db.Uuid
  status         ConversationStatus @default(OPEN)
  lastMessageAt  DateTime?
  serviceRequest ServiceRequest     @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  provider       Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerUser   User               @relation("ConversationCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  messages       Message[]
  readStates     ConversationReadState[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([providerId])
  @@index([customerUserId])
  @@index([serviceRequestId])
  @@unique([serviceRequestId, providerId])
}

model Message {
  id               String   @id @default(uuid()) @db.Uuid
  conversationId   String   @db.Uuid
  senderUserId     String   @db.Uuid
  clientMessageId  String   @db.Uuid
  body             String
  replyToMessageId String?  @db.Uuid
  createdAt        DateTime @default(now())
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  replyTo          Message?     @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]    @relation("MessageReplies")

  @@unique([conversationId, senderUserId, clientMessageId])
  @@index([conversationId, createdAt])
}

model ConversationReadState {
  conversationId String   @db.Uuid
  userId         String   @db.Uuid
  lastReadAt     DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}
