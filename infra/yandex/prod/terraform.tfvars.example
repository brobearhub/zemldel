cloud_id  = "REPLACE_WITH_CLOUD_ID"
folder_id = "REPLACE_WITH_FOLDER_ID"
zone      = "ru-central1-a"
domain    = "zemledelpro.ru"

ssh_public_key_path = "~/.ssh/id_ed25519.pub"
ssh_allowed_cidrs   = ["93.90.235.87/32"]
acme_email          = "support@zemledelpro.ru"

# Per application: one frontend VM and one backend VM.
vm_cores         = 2
vm_memory_gb     = 4
vm_core_fraction = 100
vm_disk_gb       = 20

# Per bucket, billed for actual stored data.
bucket_max_size_gb = 10

# Stage 1: provision infrastructure without switching the live domain.
publish_application_dns = false
enable_cdn_tls          = false

# Before changing NS, copy ALL current mail, Postbox DKIM and verification records.
# These examples are placeholders, not a complete mail configuration.
extra_dns_records = {}
# extra_dns_records = {
#   mail_mx = { name = "@", type = "MX", data = ["10 mx1.example.org.", "20 mx2.example.org."] }
#   mail_spf = { name = "@", type = "TXT", data = ["\"v=spf1 include:REPLACE_WITH_ACTUAL_SPF ~all\""] }
#   mail_dmarc = { name = "_dmarc", type = "TXT", data = ["\"v=DMARC1; p=none\""] }
#   postbox_dkim = { name = "REPLACE_WITH_SELECTOR._domainkey", type = "TXT", data = ["\"REPLACE_WITH_ACTUAL_DKIM\""] }
