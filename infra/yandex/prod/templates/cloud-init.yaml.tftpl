#cloud-config
users:
  - name: ubuntu
    groups: [sudo]
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: true
    ssh_authorized_keys:
      - ${jsonencode(ssh_key)}
ssh_pwauth: false
disable_root: true
package_update: true
packages:
  - ca-certificates
  - curl
  - python3
  - docker.io
  - docker-compose-v2

write_files:
  - path: /etc/docker/daemon.json
    permissions: '0644'
    content: |
      {"log-driver":"json-file","log-opts":{"max-size":"10m","max-file":"3"},"live-restore":true}
  - path: /opt/zemledel/Caddyfile
    permissions: '0644'
    content: |
      {
        email ${acme_email}
      }
      ${hostname} {
        encode gzip
        reverse_proxy app:${port}
      }
%{ if role == "frontend" ~}
      www.${hostname} {
        redir https://${hostname}{uri} permanent
      }
%{ endif ~}
  - path: /opt/zemledel/compose.yaml
    permissions: '0644'
    content: |
      services:
        app:
          image: $${IMAGE:?IMAGE must be set by the deployment command}
          restart: unless-stopped
          env_file:
            - /etc/zemledel/app.env
          environment:
            NODE_ENV: production
            PORT: '${port}'
          ports:
            - '127.0.0.1:${port}:${port}'
%{ if role == "backend" ~}
            - '${private_ip}:${port}:${port}'
          volumes:
            - /etc/zemledel/db-certs:/run/db-certs:ro
%{ endif ~}
          logging:
            driver: json-file
            options:
              max-size: '10m'
              max-file: '3'
        caddy:
          image: caddy:2.10.2-alpine
          restart: unless-stopped
          ports:
            - '80:80'
            - '443:443'
          volumes:
            - /opt/zemledel/Caddyfile:/etc/caddy/Caddyfile:ro
            - caddy_data:/data
            - caddy_config:/config
          logging:
            driver: json-file
            options:
              max-size: '10m'
              max-file: '3'
      volumes:
        caddy_data:
        caddy_config:
  - path: /usr/local/sbin/zemledel-deploy
    permissions: '0750'
    content: |
      #!/bin/sh
      set -eu
      test -s /etc/zemledel/app.env || { echo 'Upload app.env before deploying.' >&2; exit 1; }
      image="$${1:?Pass the full cr.yandex image reference with an immutable tag}"
      case "$image" in cr.yandex/*:*) ;; *) echo 'Expected cr.yandex/REGISTRY/IMAGE:TAG' >&2; exit 1;; esac
      umask 077
      iam_token=$(curl --fail --silent --show-error --max-time 10 \
        -H 'Metadata-Flavor: Google' \
        http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token \
        | python3 -c 'import sys,json; print(json.load(sys.stdin)["access_token"])')
      printf '%s' "$iam_token" | docker login --username iam --password-stdin cr.yandex
      unset iam_token
      # Only image coordinates are stored here; application secrets stay in app.env.
      printf 'IMAGE=%s\n' "$image" > /etc/zemledel/compose.env
      docker compose --env-file /etc/zemledel/compose.env -f /opt/zemledel/compose.yaml pull
      docker compose --env-file /etc/zemledel/compose.env -f /opt/zemledel/compose.yaml up -d --remove-orphans
      docker compose --env-file /etc/zemledel/compose.env -f /opt/zemledel/compose.yaml ps
      # Keep tagged images for rollback. Clean untagged layers left by interrupted pulls.
      docker image prune -f

runcmd:
  - [install, -d, -m, '0700', /etc/zemledel]
  - [install, -d, -m, '0755', /etc/zemledel/db-certs]
  - [systemctl, enable, --now, docker]
  - [systemctl, restart, docker]
  # Applications start only after their secrets and images are uploaded.
