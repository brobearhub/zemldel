# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-strong-random-secret"
BACKEND_API_URL="http://localhost:3003"
INTERNAL_API_SECRET="replace-with-shared-internal-secret"

# Planned downtime: when "true", middleware rewrites all pages to /maintenance
# (server-only, not NEXT_PUBLIC_*). Restart the Next.js process after changing.
# MAINTENANCE_MODE="true"

# Same secret as backend SOCKET_JWT_SECRET — used by /api/chat/socket-token (server-only).
SOCKET_JWT_SECRET="replace-with-socket-jwt-secret"

# Browser Socket.io URL (Nest). For local dev without reverse-proxy: http://localhost:3003
# NEXT_PUBLIC_CHAT_SOCKET_URL="http://localhost:3003"

# Публичный бакет для фолбека картинок, если CDN не открылся. Совпадает с backend YA_S3_*.
# Секреты сюда не класть: бакет читается анонимно.
# NEXT_PUBLIC_YA_S3_ENDPOINT="https://storage.yandexcloud.net"
# NEXT_PUBLIC_YA_S3_PUBLIC_BUCKET="prod-zemledel-public"
# NEXT_PUBLIC_YA_S3_FORCE_PATH_STYLE="true"

